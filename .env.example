# These are examples; set environment variables in your shell or Docker Compose.
# The application does not automatically read .env files.
CERT_DATA_DIR=./data
CERT_MAX_RECIPIENTS=10000
CERT_MAX_BODY_BYTES=8388608
CERT_POLL_SECONDS=1
# Set a secret before exposing the API. Clients must send X-API-Key.
CERT_API_KEY=
# Cloud deployment: use a Neon PostgreSQL connection URL (includes sslmode=require).
DATABASE_URL=
# Run the PDF worker within the API's lifespan on Render; one Uvicorn worker only.
CERT_EMBEDDED_WORKER=false
# Vercel build environment only; never put database credentials into frontend variables.
BACKEND_URL=https://YOUR-SERVICE.onrender.com

